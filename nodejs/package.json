{
  "name": "nwea-playbook",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "YAML playbooks that drive a browser to download NWEA MAP reports",
  "bin": {
    "nwea-playbook": "bin/nwea-playbook.mjs"
  },
  "scripts": {
    "nwea": "cd .. && tsx nodejs/run.ts nwea-class-profile.yaml",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "coverage": "node --import tsx --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
